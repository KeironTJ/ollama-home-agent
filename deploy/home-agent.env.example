# Secrets only. Non-secret URLs, allowlists, Wake-on-LAN settings, and CA
# paths are managed through home-agent.config.json or the localhost setup UI.
HOME_AGENT_PROXMOX_TOKEN_SECRET=
HOME_AGENT_CRAFTY_READ_TOKEN=
HOME_AGENT_CRAFTY_ACTION_TOKEN=

# Optional web port override. The systemd unit binds to all container interfaces.
HOME_AGENT_PORT=8080

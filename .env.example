# Web server
HOME_AGENT_HOST=127.0.0.1
HOME_AGENT_PORT=8080
HOME_AGENT_DATA_DIR=./data

# Ollama
HOME_AGENT_OLLAMA_URL=http://127.0.0.1:11434
HOME_AGENT_OLLAMA_MODEL=llama3.1:8b
HOME_AGENT_MAX_AGENT_ITERATIONS=5
HOME_AGENT_REQUEST_TIMEOUT_SECONDS=45
HOME_AGENT_MAX_TOOL_OUTPUT_CHARS=12000

# Proxmox API token (never commit the real values)
HOME_AGENT_PROXMOX_URL=https://192.168.1.232:8006
HOME_AGENT_PROXMOX_TOKEN_ID=home-agent@pve!diagnostic
HOME_AGENT_PROXMOX_TOKEN_SECRET=
# Preferred: export/download the Proxmox CA and set this path.
HOME_AGENT_PROXMOX_CA_FILE=C:\path\to\proxmox-ca.pem
# Unsafe fallback for a private network only. The UI displays a warning.
HOME_AGENT_PROXMOX_INSECURE_TLS=false
HOME_AGENT_PROXMOX_ALLOWED_NODES=pve
HOME_AGENT_PROXMOX_ALLOWED_GUESTS=100,101

# Optional restricted SSH. JSON values are fixed destinations/allowlists.
# Password authentication is intentionally unsupported; use a dedicated key.
HOME_AGENT_SSH_USERNAME=diagnostic-agent
HOME_AGENT_SSH_KEY_FILE=C:\Users\you\.ssh\home-agent
HOME_AGENT_SSH_HOSTS_JSON={}
# Example after SSH is intentionally configured:
# HOME_AGENT_SSH_HOSTS_JSON={"minecraft":{"hostname":"192.168.1.50","services":["minecraft"],"ports":[25565]}}

# Optional local voice transcription (install with: pip install -e ".[voice]")
HOME_AGENT_WHISPER_MODEL_SIZE=tiny
